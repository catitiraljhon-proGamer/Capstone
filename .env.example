# MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=g4_construction

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Optional Google login and signup (OAuth client type: Web application).
# Register this exact redirect URI in Google Auth Platform > Clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email for registration codes and customer notifications. Required in production;
# locally, codes are printed in the dev server log when unset. Use ONE of the two options.
# Option A: any SMTP relay, e.g. Brevo (host smtp-relay.brevo.com, port 587, SMTP login + SMTP key).
# EMAIL_FROM must be a sender address verified with that provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Option B: Gmail SMTP. Needs 2-Step Verification; create the password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender name and the site address used for links inside emails.
EMAIL_FROM_NAME=G4 Builders Inc
APP_URL=http://localhost:3000

# Required by `npm run db:seed`.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional initial accounts. Supply all three values for an account to be created.
SEED_CLERK_NAME=
SEED_CLERK_EMAIL=
SEED_CLERK_PASSWORD=
SEED_CUSTOMER_NAME=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
